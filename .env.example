# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GitStat Netrunner Edition — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Optional API key authentication (leave empty to disable)
GITSTAT_API_KEY=

# CORS allowed origins (comma-separated)
GITSTAT_CORS_ORIGINS=http://127.0.0.1:12580,http://localhost:12580,http://127.0.0.1:5173,http://localhost:5173

# Gitee API token (optional, enables authenticated access to private repos)
GITEE_TOKEN=

# Frontend build vars
VITE_API_BASE=
VITE_API_TARGET=http://127.0.0.1:12580